<script is:inline>
  (function () {
    var cmd = document.getElementById("installCmd");
    var tabs = document.querySelectorAll(".install-tabs [role=tab]");
    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        tabs.forEach(function (t) {
          t.setAttribute("aria-selected", String(t === tab));
        });
        cmd.textContent = tab.dataset.cmd;
      });
    });
    var copy = document.getElementById("copyHero");
    copy.addEventListener("click", function () {
      if (navigator.clipboard) navigator.clipboard.writeText(cmd.textContent);
      copy.textContent = "copied";
      setTimeout(function () {
        copy.textContent = "copy";
      }, 1400);
    });

    // One turn of the loop: a radius sweeps 0 -> tau, lighting each step.
    var TAU = Math.PI * 2,
      cx = 260,
      cy = 240,
      R = 175,
      PERIOD = 9000;
    var radius = document.getElementById("loopRadius");
    var wedge = document.getElementById("loopWedge");
    var readout = document.getElementById("loopTheta");
    var steps = document.querySelectorAll(".hero-loop [data-step]");
    function draw(theta) {
      var x = cx + R * Math.cos(theta),
        y = cy - R * Math.sin(theta);
      radius.setAttribute("x2", x.toFixed(1));
      radius.setAttribute("y2", y.toFixed(1));
      wedge.style.strokeDasharray = (theta * 24).toFixed(1) + " 999";
      var active = Math.floor(theta / (TAU / 4)) % 4;
      steps.forEach(function (el) {
        el.classList.toggle("on", Number(el.dataset.step) === active);
      });
      readout.textContent =
        "θ = " + theta.toFixed(2) + (theta > TAU - 0.05 ? " = τ" : "");
    }
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      draw(TAU * 0.3);
      return;
    }
    var start = null;
    function frame(t) {
      if (start === null) start = t;
      draw((((t - start) % PERIOD) / PERIOD) * TAU);
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>

<script is:inline>
  // Draw each hand-drawn figure, stroke by stroke, when it scrolls into view.
  (function () {
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var SKIP = { loopRadius: 1, loopWedge: 1, loopTheta: 1 };
    var TOTAL = 1600,
      DRAW = 500,
      FADE = 400;
    document.querySelectorAll("figure.sketch").forEach(function (fig) {
      var els = Array.prototype.filter.call(
        fig.querySelectorAll("svg path, svg circle, svg text"),
        function (el) {
          return !el.closest("defs") && !SKIP[el.id];
        },
      );
      var step = Math.min(70, TOTAL / Math.max(els.length, 1));
      var markers = [];
      els.forEach(function (el, i) {
        el.style.setProperty("--i", String(i));
        el.style.setProperty("--step", step + "ms");
        var stroked =
          el.closest(".ink") &&
          el.tagName !== "text" &&
          !el.classList.contains("flow");
        el.classList.add(stroked ? "draw" : "fade");
        if (stroked) el.setAttribute("pathLength", "1");
        var m = el.getAttribute("marker-end");
        if (m) {
          el.removeAttribute("marker-end");
          markers.push({ el: el, m: m, at: i * step + DRAW });
        }
      });
      fig.classList.add("pending");
      var io = new IntersectionObserver(
        function (entries) {
          if (!entries[0].isIntersecting) return;
          io.disconnect();
          fig.classList.remove("pending");
          markers.forEach(function (x) {
            setTimeout(function () {
              x.el.setAttribute("marker-end", x.m);
            }, x.at);
          });
          // Hand control back to the figure's own styles once drawing is done.
          setTimeout(
            function () {
              els.forEach(function (el) {
                el.classList.remove("draw", "fade");
                el.removeAttribute("pathLength");
              });
            },
            els.length * step + DRAW + FADE + 300,
          );
        },
        { threshold: 0.3 },
      );
      io.observe(fig);
    });
  })();
</script>
